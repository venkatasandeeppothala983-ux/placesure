# Copy to .env. This file contains examples, never production credentials.
DB_URL=jdbc:mysql://127.0.0.1:3306/placesure?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USER=placesure_app
DB_PASSWORD=replace_with_your_local_password
PORT=8080
BIND_HOST=0.0.0.0
# Integration tests need a SEPARATE database, never the application's database.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/placesure_test?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
TEST_DB_USER=placesure_app
TEST_DB_PASSWORD=replace_with_your_local_password
